# Copy to .env for local use. Without DATABASE_URL, Kizuna uses a built-in local Postgres (PGlite) in data/pglite.

# Neon (or any Postgres). Use the *pooled* connection string from the Neon dashboard.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: require this code to create an account.
# KIZUNA_INVITE_CODE=choose-a-secret

# Optional: per-file upload limit in MB (files are stored in the database). Default 10.
# KIZUNA_MAX_FILE_MB=10

# PORT=4000
