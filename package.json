{
  "name": "kizuna",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Kizuna — the workspace chat for co-founders and small teams. Messages, tasks, ideas, goals and decisions in one place.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite --host",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "test": "node --test server/test/",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6",
    "@electric-sql/pglite": "^0.5.14",
    "@tanstack/react-query": "^5.105.1",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
